# Logging: INFO logs each request (method, path, status, duration). DEBUG adds redacted headers.
LOG_LEVEL=INFO

# Meta webhook verification (must match the token in Meta Developer Console)
VERIFY_TOKEN=

# WhatsApp Cloud API — from Meta App Dashboard → WhatsApp → API Setup
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Optional: App Secret → enables X-Hub-Signature-256 verification on POST /webhook
WHATSAPP_APP_SECRET=

# OpenAI (required for POST /webhook agent replies)
OPENAI_API_KEY=
# Optional model id for the WhatsApp agent (default: gpt-4o-mini)
OPENAI_AGENT_MODEL=
