# Logging: INFO logs each request (method, path, status, duration). DEBUG adds redacted headers.
LOG_LEVEL=INFO

# Meta webhook verification (must match the token in Meta Developer Console)
VERIFY_TOKEN=

# WhatsApp Cloud API — from Meta App Dashboard → WhatsApp → API Setup
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Optional: App Secret → enables X-Hub-Signature-256 verification on POST /webhook
WHATSAPP_APP_SECRET=

# Optional — WhatsApp Flows (text command `form` opens your published flow).
# WHATSAPP_FLOW_ID: Meta Business Suite → WhatsApp account → Flows (or WhatsApp Manager → Flows).
#   Open a published flow; copy its Flow ID (numeric string, also used in Flows API / test sends).
# WHATSAPP_FLOW_SCREEN: The opening screen’s `id` from that flow’s JSON (Flow Builder / export).
#   Must match the screen you want `flow_action: navigate` to land on (first screen is common).
WHATSAPP_FLOW_ID=
WHATSAPP_FLOW_SCREEN=
