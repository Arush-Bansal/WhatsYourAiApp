# Logging: INFO logs each request (method, path, status, duration). DEBUG adds redacted headers.
LOG_LEVEL=INFO

# Meta webhook verification (must match the token in Meta Developer Console)
VERIFY_TOKEN=

# WhatsApp Cloud API — from Meta App Dashboard → WhatsApp → API Setup
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Optional: App Secret → enables X-Hub-Signature-256 verification on POST /webhook
WHATSAPP_APP_SECRET=

# Slack — from api.slack.com/apps → OAuth & Permissions / Basic Information
# Bot scopes: chat:write, im:history, files:read
# Event URL: https://<host>/slack/events (subscribe to message.im)
# Interactivity URL: https://<host>/slack/interactions
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=

# OpenAI (required for POST /webhook agent replies)
OPENAI_API_KEY=
# Optional model id for the WhatsApp agent (default: gpt-4o-mini)
OPENAI_AGENT_MODEL=

# Gmail — OAuth for a single business inbox + Pub/Sub push notifications
# 1. Enable Gmail API in GCP; create OAuth Desktop credentials
# 2. Run: GMAIL_CLIENT_ID=... GMAIL_CLIENT_SECRET=... python scripts/gmail_oauth_setup.py
# 3. Create Pub/Sub topic + push subscription to https://<host>/gmail/push
# 4. Grant gmail-api-push@system.gserviceaccount.com publish on the topic
# 5. After deploy: POST /gmail/watch with header X-Gmail-Watch-Secret (daily cron recommended)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_MAILBOX_EMAIL=
GMAIL_PUBSUB_TOPIC=
GMAIL_PUSH_AUDIENCE=
GMAIL_WATCH_SECRET=
GMAIL_STATE_PATH=.gmail_state.json
